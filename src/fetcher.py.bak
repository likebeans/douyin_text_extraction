                video_url = play_addr['url_list'][0]
            
            if not video_url:
                console.print("[red]❌ 无法获取视频播放地址[/red]")
                return None
            
            # 构建元数据
            metadata = VideoMetadata(
                video_id=video_id,
                title=aweme.get('desc', '无标题'),
                author=aweme.get('author', {}).get('nickname', '未知作者'),
                duration=video_info.get('duration', 0) // 1000,  # 毫秒转秒
                video_url=video_url,
                cover_url=video_info.get('cover', {}).get('url_list', [''])[0]
            )
            
            console.print(f"[green]✅ 视频信息获取成功[/green]")
            console.print(f"   标题: {metadata.title}")
            console.print(f"   作者: {metadata.author}")
            console.print(f"   时长: {metadata.duration} 秒")
            
            return metadata
            

# DashScope 云端语音识别；使用本地 Whisper 时设置 ASR_PROVIDER=local
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key
ASR_PROVIDER=dashscope
ASR_MODEL=paraformer-v2
WHISPER_MODEL=base

# 提取与输出
MAX_VIDEO_DURATION=600
OUTPUT_DIR=./output
REQUEST_TIMEOUT=30
DOWNLOAD_TIMEOUT=300
RETRY_TIMES=3
ASR_TIMEOUT=600
FFMPEG_TIMEOUT=120
MAX_DOWNLOAD_BYTES=536870912

# 可选 OSS 兜底；启用前请填写自己的 OSS 配置
OSS_ENABLE_FALLBACK=false
OSS_ACCESS_KEY_ID=replace-with-your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-oss-access-key-secret
OSS_BUCKET_NAME=your-bucket-name
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_ENDPOINT_INTERNAL=
OSS_REGION=
OSS_CDN_DOMAIN=

# 临时文件
TEMP_DIR=./temp
CLEANUP_TEMP_FILES=true

# Web 服务。默认仅监听本机；远程监听必须设置随机令牌并关闭调试
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
WEB_API_TOKEN=
WEB_PUBLIC_ORIGIN=
WEB_CONFIG_ENABLED=true
WEB_MAX_CONCURRENT_EXTRACTIONS=2
